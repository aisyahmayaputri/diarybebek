.mood-section {
    margin-bottom: 40px;
}

.section-title {
    font-size: 20px;
    color: var(--text-main);
    margin-bottom: 4px;
}

.section-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 16px;
}

.mood-container {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.mood-chip {
    padding: 10px 16px;
    border-radius: 20px;
    background-color: var(--card-bg);
    border: 2px solid transparent;
    color: var(--text-main);
    font-weight: 600;
    font-family: inherit;
    font-size: 14px;
    transition: all 0.3s ease;
}

/* Saat mood dipilih (Bisa multi-select) */
.mood-chip.selected {
    background-color: var(--accent-color);
    border: 2px solid var(--text-main);
    transform: scale(1.05); /* Sedikit membesar saat dipilih (bouncy feel) */
}
