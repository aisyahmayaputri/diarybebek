.scrapbook-bubble {
    background-color: var(--card-bg);
    border: 3px solid var(--border-color);
    border-radius: 50px 50px 50px 0 / 50px 50px 50px 0; /* Ujung kiri bawah lancip */
    padding: 30px;
    position: relative;
    box-shadow: 4px 4px 0px rgba(93, 64, 55, 0.1);
    min-height: 150px;
}

.mood-container {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

.mood-item-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.mood-chip {
    background-color: var(--bg-color);
    padding: 10px 18px;
    font-family: inherit;
    font-weight: 700;
    font-size: 14px;
    color: var(--text-main);
    cursor: pointer;
    transition: transform 0.2s ease;
}

.mood-chip.selected {
    background-color: var(--accent-color);
    transform: scale(1.05);
}

/* Kotak pengukur intensitas */
.intensity-selector {
    background-color: var(--bg-color);
    border: 2px dashed var(--border-color);
    padding: 6px 12px;
    border-radius: 12px;
    margin-top: 8px;
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.intensity-selector.hidden {
    display: none;
}

.mood-slider {
    width: 60px;
    accent-color: var(--border-color);
}
