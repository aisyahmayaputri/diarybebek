/* Definisi 4 Tema Sesuai Permintaan */
:root[data-theme="terang"] {
    --bg-color: #FAFAFA; /* Putih sedikit cream */
    --text-main: #3E2723; /* Coklat tua */
    --text-secondary: #795548;
    --card-bg: #FFFFFF;
    --accent-color: #D7CCC8; /* Coklat muda */
}

:root[data-theme="gelap"] {
    --bg-color: #121212; /* Hitam malam */
    --text-main: #E0E0E0; /* Abu-abu terang */
    --text-secondary: #9E9E9E;
    --card-bg: #1E1E1E;
    --accent-color: #37474F; /* Biru malam */
}

:root[data-theme="autumn"] {
    --bg-color: #FFF3E0;
    --text-main: #5D4037;
    --text-secondary: #8D6E63;
    --card-bg: #FFE0B2;
    --accent-color: #FFB300;
}

:root[data-theme="baby"] {
    --bg-color: #F0F8FF; /* Alice blue */
    --text-main: #0277BD; /* Biru mencolok untuk font */
    --text-secondary: #4FC3F7;
    --card-bg: #FFFFFF;
    --accent-color: #81D4FA; /* Biru lembut */
}
